[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = req_distinguished_name
req_extensions = v3_req

[req_distinguished_name]
countryName = CN
stateOrProvinceName = Xinjiang
localityName = Urumqi
organizationName = DOCKER Certificate Authority
organizationalUnitName = Docker Server Certificate
commonName = dserver.jianlu.site
# emailAddress = jianlu8023@gmail.com

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = dserver.jianlu.site
DNS.2 = *.jianlu.site
DNS.4 = jianlu.site
DNS.3 = localhost
IP.1 = 127.0.0.1
IP.2 = 192.168.58.110

[v3_docker_server_cert]
basicConstraints = critical, CA:FALSE # 这是一个终端实体证书，不能签发其他证书
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
keyUsage = critical, digitalSignature, keyEncipherment # 数字签名和密钥加密是TLS服务器必需的
extendedKeyUsage = serverAuth # 明确指定此证书用于TLS服务器认证
subjectAltName = @alt_names # 确保SANs最终包含在签发的证书中