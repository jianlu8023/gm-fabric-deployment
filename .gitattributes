# git config --global core.autocrlf true  # Windows 环境推荐
# git config --global core.autocrlf input # Unix/macOS 环境推荐
# git config --global core.autocrlf false # 禁用自动换行符转换 (不推荐)

# git config --get core.autocrlf      # 查看当前仓库的设置
# git config --global --get core.autocrlf # 查看全局设置


# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto eol=lf

# Force bash scripts to always use LF line endings so that if a repo is accessed
# in Unix via a file share from Windows, the scripts will work.
*.sh text eol=lf


# 明确指定 go.mod 和 go.sum 文件为文本文件
go.mod text eol=lf
go.sum text eol=lf

# 明确指定 .tmpl 和 .tpl 文件为文本文件
*.tmpl text eol=lf
*.tpl text eol=lf

# 明确指定 Makefile 文件为文本文件
Makefile text eol=lf

# 明确指定 Dockerfile 文件为文本文件
Dockerfile text eol=lf
